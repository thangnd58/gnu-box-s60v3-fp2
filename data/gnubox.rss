#include <eikon.rh>
#include <uikon.rh>
#include <eikcore.rsg>
#include "gnubox.hrh"

#ifdef __SERIES60__
#include <avkon.rh>
#include <avkon.rsg>
#include <avkon.mbg>
#include <appinfo.rh>
#endif

//  CONSTANTS  

//  MACROS

//  RESOURCE DEFINITIONS 

RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF { buf="gnubox"; }

RESOURCE EIK_APP_INFO
{
  hotkeys=r_gnubox_hotkeys;
  menubar=r_gnubox_menubar;
#ifdef __SERIES60__
  cba=R_AVKON_SOFTKEYS_OPTIONS_BACK;
#endif
}

RESOURCE HOTKEYS r_gnubox_hotkeys
{
  control=
    {
#ifdef __SERIES60__
      HOTKEY { command=EAknCmdExit; key='e'; }
#else //UIQ
      HOTKEY { command=EEikCmdExit; key='e'; }
#endif
    };
}

RESOURCE MENU_BAR r_gnubox_menubar
{
  titles=
    {
      MENU_TITLE { menu_pane=r_gnubox_menu; txt="Options"; }
    };
}

RESOURCE MENU_PANE r_gnubox_menu
{
  items=
    {
      MENU_ITEM { command=EGnuboxCmdAppStartConn; txt="Bring up IF"; },
      MENU_ITEM { command=EGnuboxCmdAppBluetoothDirectSer; txt="2box Serial"; },
      MENU_ITEM { command=EGnuboxCmdAppAddRecords; txt="Create records"; },
      MENU_ITEM { command=EGnuboxCmdAppSetGPRS; txt="Set to GPRS"; },
      MENU_ITEM { command=EGnuboxCmdAppDelRecords; txt="Delete records"; },
      MENU_ITEM { command=EEikCmdExit; txt="Exit"; }
    };
}

#ifdef __SERIES60__
RESOURCE DIALOG r_gnubox_encrypt_confirm_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_YES_NO;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_CONFIRMATION_QUERY
                {
                layout = EConfirmationQueryLayout;
                label = "Do you want to require encryption?";
                };
            }
        };
    }


//
RESOURCE DIALOG r_dialog_telnum_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_DATA_QUERY
                {
                layout = EDataLayout;
                label = "Enter phone number:";
                control = EDWIN
                    {
                    maxlength = 20;
                    default_input_mode = EAknEditorNumericInputMode;
                    };
                };
            }
        };
    }

#endif

#ifdef __UIQ__

RESOURCE DIALOG r_dialog_telnum_query
        {
        buttons=R_EIK_BUTTONS_CANCEL_OK;
        flags=EEikDialogFlagWait;
        items=
                {
                DLG_LINE
                        {
                        type=EEikCtEdwin;
                        prompt="Enter phone number:";
                        id=EDialogControlIdText;
                        control=EDWIN {width=100;maxlength=20;};
                        }
                };
        }
#endif

#define PROMPT "The Accesspoint is now set to GPRS mode. You can now edit the accesspoint in the phone settings. You will be unable to use it until you click Install->createrecords in gnubox, which will re-set it to Data call (and thus hide it)."


#define PROMPT2 "Once you have finished editing the accesspoint, you will also want to click Install->Copy GPRS settings to get the modifications copied."

