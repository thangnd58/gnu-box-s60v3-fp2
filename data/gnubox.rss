RESOURCE HOTKEYS r_gnubox_hotkeys
{
  control=
    {
#ifdef __SERIES60__
      HOTKEY { command=EAknCmdExit; key='e'; }
#else //UIQ
      HOTKEY { command=EEikCmdExit; key='e'; }
#endif
    };
}

RESOURCE MENU_BAR r_gnubox_menubar
{
  titles=
    {
      MENU_TITLE { menu_pane=r_gnubox_menu; txt="Options"; }
    };
}

RESOURCE MENU_PANE r_gnubox_menu
{
  items=
    {
      MENU_ITEM 
      {
        command=EGnuboxCmdAppDirect;txt="2box Bluetooth";
        cascade=r_gnubox_bluetooth_submenu;
      },
      MENU_ITEM 
      {
        command=EGnuboxCmdAppInfraredDirect;txt="2box Infrared";
      },
      MENU_ITEM 
      {
        command=EGnuboxCmdAppCableDirect;txt="2box Cable";
      },
      MENU_ITEM { command=EGnuboxCmdAppCSD_GPRS; txt="1box Phone"; },
      MENU_ITEM 
      {
        command=EGnuboxCmdAppInstall;txt="Install";
        cascade=r_gnubox_install_submenu;
      },
      MENU_ITEM 
      {
        command=EGnuboxCmdAppDebug;txt="Debug";
        cascade=r_gnubox_debug_submenu;
      },
      /*      MENU_ITEM 
              //THIS WORKS BUT TOO DANGEROUS => COMMENTED OUT
              //it sets ModemForDataAndFax and ModemForPhoneServicesAndSms to
              //values 2 or 6, but this is hardcoded. 
              //If you have a setting anything else than 2 or 6 then
              //clicking on any item here is irreversible.
      {
        command=EGnuboxCmdAppDebug;txt="Manually set modem ID";
        cascade=r_gnubox_modemid_submenu;
        },*/
      MENU_ITEM { command=EEikCmdExit; txt="Exit"; }
    };
}


RESOURCE MENU_PANE r_gnubox_bluetooth_submenu
{
  items=
    {
      MENU_ITEM {command=EGnuboxCmdAppBluetoothDirectMR; txt="Auto"; },
      MENU_ITEM {command=EGnuboxCmdAppBluetoothDirectSer; txt="Serial port"; },
      MENU_ITEM {command=EGnuboxCmdAppBluetoothDirectLan; txt="LAN Access server"; },
      MENU_ITEM {command=EGnuboxCmdAppBluetoothDirectDun; txt="Dial-up networking"; }
    };
}

RESOURCE MENU_PANE r_gnubox_install_submenu
{
  items=
    {
      MENU_ITEM { command=EGnuboxCmdAppSetupScript; txt="set RAS login script"; },
#ifdef ENABLESETMODEMID
      MENU_ITEM { command=EGnuboxCmdAppSetModemID; txt="auto set modem ID"; },
      MENU_ITEM { command=EGnuboxCmdAppUnsetModemID; txt="auto unset modem ID"; },
#endif
      MENU_ITEM { command=EGnuboxCmdAppAddRecords; txt="create records"; },
      MENU_ITEM { command=EGnuboxCmdAppDelRecords; txt="delete records"; }
#ifdef ENABLEGPRSCOPY
      ,
      MENU_ITEM { command=EGnuboxCmdAppSetGPRS; txt="set to GPRS"; },
      MENU_ITEM { command=EGnuboxCmdAppCopyFromGPRS; txt="copy settings from GPRS"; },
      MENU_ITEM { command=EGnuboxCmdAppChangeConnPref; txt="set default AP to Bt"; },
      MENU_ITEM { command=EGnuboxCmdAppRevertConnPref; txt="set default AP to GPRS"; }
#endif
#ifdef ENABLESETTELNO
      ,
      MENU_ITEM { command=EGnuboxCmdAppSetTelNo; txt="set tel.no";}
#endif
    };
}

RESOURCE MENU_PANE r_gnubox_debug_submenu
{
