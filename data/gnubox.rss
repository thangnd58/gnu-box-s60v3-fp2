      MENU_ITEM {command=EGnuboxCmdAddMRouterDefRoute; txt="use mRouter"; },
      MENU_ITEM {command=EGnuboxCmdAppCommTest; txt="Test comm channel"; },
      MENU_ITEM {command=EGnuboxCmdAppCommPref; txt="Dump ConnPref"; },
#ifdef MODEMINIT
      MENU_ITEM {command=EGnuboxCmdAppWriteModemInit; txt="Set modem init string"; },
#endif
      MENU_ITEM {command=EGnuboxCmdAppDumpCommInfo; txt="dump comm info"; },
      //      MENU_ITEM {command=EGnuboxCmdAppFixupModemEntry; txt="fixup modem entry"; }
      MENU_ITEM {command=EGnuboxCmdAppDumpAppInfo; txt="dump app list"; },
      MENU_ITEM {command=EGnuboxCmdDumpProcInfo; txt="dump proc list"; }

    };
}

RESOURCE MENU_PANE r_gnubox_modemid_submenu
{
