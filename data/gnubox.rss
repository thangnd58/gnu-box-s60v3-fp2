#ifdef __SERIES60__
RESOURCE DIALOG r_gnubox_encrypt_confirm_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_YES_NO;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_CONFIRMATION_QUERY
                {
                layout = EConfirmationQueryLayout;
                label = "Do you want to require encryption?";
                };
            }
        };
    }


//
RESOURCE DIALOG r_dialog_telnum_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_DATA_QUERY
                {
                layout = EDataLayout;
                label = "Enter phone number:";
                control = EDWIN
                    {
                    maxlength = 20;
                    default_input_mode = EAknEditorNumericInputMode;
                    };
                };
            }
        };
    }

#endif

#ifdef __UIQ__

RESOURCE DIALOG r_dialog_telnum_query
        {
        buttons=R_EIK_BUTTONS_CANCEL_OK;
        flags=EEikDialogFlagWait;
        items=
                {
                DLG_LINE
                        {
                        type=EEikCtEdwin;
                        prompt="Enter phone number:";
                        id=EDialogControlIdText;
                        control=EDWIN {width=100;maxlength=20;};
                        }
                };
        }
#endif

